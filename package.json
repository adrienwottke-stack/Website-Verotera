{
  "name": "website-verotera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node site-tools/build.mjs && node site-tools/preview.mjs",
    "build": "node site-tools/build.mjs",
    "start": "node site-tools/preview.mjs",
    "check": "node site-tools/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:legacy": "next dev --webpack -p 3001",
